PORT=3000
JWT_SECRET=pasarin-marketplace-super-secret-key-2026

# Tipe Database: "sqlite" | "supabase" | "mysql"
# STATUS: Supabase cloud AKTIF via Connection Pooler IPv4 (region ap-northeast-2).
# Tabel + 60 produk + 6 promo sudah dibuat & di-seed ke project vgraouxizjvfnpzfebyb.
# Tanpa pooler: host db.*.supabase.co bersifat IPv6-only; aplikasi otomatis fallback ke SQLite.
DB_TYPE=supabase

# ========================================================
# SUPABASE (Cloud)
# ========================================================
SUPABASE_URL=https://vgraouxizjvfnpzfebyb.supabase.co
# Opsional (hanya utk @supabase/supabase-js REST/HTTPS). Koneksi DB utama pakai DATABASE_URL.
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Connection Pooler IPv4 (project region: ap-northeast-2). Punya record A/IPv4.
# Format umum: postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.vgraouxizjvfnpzfebyb:168parts2026@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
# Parameter terpisah (host direct IPv6-only; dipakai bila jaringan punya IPv6):
PG_HOST=db.vgraouxizjvfnpzfebyb.supabase.co
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=168parts2026


# ========================================================
# 📦 KONFIGURASI SQLITE (Lokal Instan Tanpa Server)
# ========================================================
SQLITE_FILE=./backend/data/pasarin_local.db

# ========================================================
# 🐬 KONFIGURASI MYSQL (Opsional XAMPP / Laragon)
# ========================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pasarin_db

