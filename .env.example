PORT=3000
JWT_SECRET=pasarin-marketplace-super-secret-key-2026

# Tipe Database yang digunakan: "sqlite" (Lokal Instan), "supabase" (Cloud), atau "mysql"
DB_TYPE=sqlite

# ========================================================
# ⚡ KONFIGURASI SUPABASE (Cloud Database)
# ========================================================
# 1. URL & API Key (Dari Dashboard Supabase -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# 2. Connection String PostgreSQL Supabase (Direct SQL Connection Pooler)
# Dari Dashboard Supabase -> Project Settings -> Database -> Connection String (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres

# ========================================================
# 📦 KONFIGURASI SQLITE (Lokal Instan Tanpa Server)
# ========================================================
SQLITE_FILE=./backend/data/pasarin_local.db

# ========================================================
# 🐬 KONFIGURASI MYSQL (Opsional XAMPP / Laragon)
# ========================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pasarin_db

